/**
 * Найти координаты помещения.
 *
 * @param {string} object   Название объекта (как в форме).
 * @param {string} building Корпус: «Основное здание» / «Крыло мастерских» / «Чердак».
 * @param {string} floor    Этаж: '1', '2', '3', 'Подвал', 'Чердак'.
 * @param {string} num      Номер помещения (без префикса «к»).
 * @returns {string}        Координаты или '' если не найдено.
 */
function lookupRoomCoords(object, building, floor, num) {
  const objData = ROOM_COORDS[object];
  if (!objData) return '';

  const buildData = objData[building];
  if (!buildData) return '';

  // Чердак — без разбивки по этажам.
  if (building === 'Чердак') {
    return buildData[String(num)] || '';
  }

  const floorData = buildData[String(floor)];
  if (!floorData) return '';

  return floorData[String(num)] || '';
}